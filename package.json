{
  "name": "plasmatio",
  "version": "1.1.1",
  "author": "Virgil",
  "private": true,
  "description": "A faithful, offline desktop UI of the six PLASMATIO reference screens.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node tests/ui.cjs",
    "release:windows": "node scripts/release-windows.cjs",
    "pack": "electron-packager . Plasmatio --out=dist --overwrite --ignore='^/(dist|releases|scripts|tests|build|\\.git)($|/)'"
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "electron": "37.10.3",
    "playwright": "1.62.1"
  }
}
